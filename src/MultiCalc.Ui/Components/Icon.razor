@* Every icon in the app, in one place. Stroked, 24x24, inherits colour.

   The width and height attributes are not decoration. An svg with only a viewBox has no
   intrinsic size, so inside a flex row it stretches to the default 300x150 and swallows
   the layout. CSS can shrink it afterwards; these keep it sane if nothing does. *@

<svg class="ic" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "layers":
            <rect x="3" y="3" width="12" height="12" rx="2.5" />
            <path d="M9 21h9a3 3 0 0 0 3-3V9" />
            break;

        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;

        case "more":
            <circle cx="12" cy="5.5" r="1.4" fill="currentColor" stroke="none" />
            <circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none" />
            <circle cx="12" cy="18.5" r="1.4" fill="currentColor" stroke="none" />
            break;

        @* A function curve: the scientific keys. *@
        case "science":
            <path d="M3.5 18.5c3.2 0 4.2-13 8.5-13s5.3 13 8.5 13" />
            <path d="M4 12.5h6" />
            break;

        case "history":
            <path d="M3.5 12a8.5 8.5 0 1 0 2.6-6.1" />
            <path d="M3 4v4h4" />
            <path d="M12 7.5V12l3 2" />
            break;

        case "close":
            <path d="M6 6l12 12M18 6L6 18" />
            break;

        case "check":
            <path d="M4.5 12.5l5 5 10-11" />
            break;

        case "back":
            <path d="M15 5l-7 7 7 7" />
            break;

        case "chevron":
            <path d="M9 5l7 7-7 7" />
            break;

        case "chevron-down":
            <path d="M6 9.5l6 6 6-6" />
            break;

        case "export":
            <path d="M12 15V3" />
            <path d="M8 7l4-4 4 4" />
            <path d="M4 15v3a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3v-3" />
            break;

        case "import":
            <path d="M12 3v12" />
            <path d="M8 11l4 4 4-4" />
            <path d="M4 15v3a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3v-3" />
            break;

        case "trash":
            <path d="M4 6.5h16" />
            <path d="M9 6.5V5a1.5 1.5 0 0 1 1.5-1.5h3A1.5 1.5 0 0 1 15 5v1.5" />
            <path d="M6.5 6.5 7.4 19a2 2 0 0 0 2 1.9h5.2a2 2 0 0 0 2-1.9l.9-12.5" />
            break;

        case "edit":
            <path d="M4 20h4.5L20 8.5a2.1 2.1 0 0 0-3-3L5.5 17V20z" />
            break;

        case "settings":
            <circle cx="12" cy="12" r="3.1" />
            <path d="M12 2.8v2.4M12 18.8v2.4M4.5 7.5l2 1.2M17.5 15.3l2 1.2M4.5 16.5l2-1.2M17.5 8.7l2-1.2" />
            break;

        case "info":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 11v5.5" />
            <circle cx="12" cy="7.9" r="1" fill="currentColor" stroke="none" />
            break;

        case "heart":
            <path d="M12 20.5S3.5 15.4 3.5 9.4A4.4 4.4 0 0 1 12 7.3a4.4 4.4 0 0 1 8.5 2.1c0 6-8.5 11.1-8.5 11.1z" />
            break;

        @* Another calculator inside MultiCalc: two stacked bodies, plus a plus. *@
        case "calc-app":
            <path d="M12.5 8V6.2A1.9 1.9 0 0 0 10.6 4.3H4.4A1.9 1.9 0 0 0 2.5 6.2v9.1a1.9 1.9 0 0 0 1.9 1.9H6" />
            <rect x="6" y="8" width="9.5" height="13.2" rx="2" />
            <path d="M8.4 11.4h4.7" />
            <path d="M8.4 14.7h.01M10.75 14.7h.01M13.1 14.7h.01M8.4 17.9h.01M10.75 17.9h.01M13.1 17.9h.01"
                  stroke-width="2.3" />
            <path d="M19.5 2.5v6M16.5 5.5h6" />
            break;

        @* Another copy of the phone's own calculator: one body, plus a plus. *@
        case "calc-phone":
            <rect x="2.5" y="4.5" width="11" height="16.2" rx="2.2" />
            <path d="M5.2 8.2h5.6" />
            <path d="M5.2 12h.01M7.9 12h.01M10.6 12h.01M5.2 15.2h.01M7.9 15.2h.01M10.6 15.2h.01M5.2 18.3h.01M7.9 18.3h.01"
                  stroke-width="2.3" />
            <path d="M19.5 2.5v6M16.5 5.5h6" />
            break;

        case "backspace":
            <path d="M9 5h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H9l-6-7z" />
            <path d="M12.5 9.5l4 5M16.5 9.5l-4 5" />
            break;

        case "external":
            <path d="M14 4h6v6" />
            <path d="M20 4l-8.5 8.5" />
            <path d="M19 14v4.5a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 3 18.5v-11A2.5 2.5 0 0 1 5.5 5H10" />
            break;

        case "github":
            <path fill="currentColor" stroke="none" d="M12 1.8a10.2 10.2 0 0 0-3.2 19.9c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.3-3.4-1.3-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-4.9 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.7 1a9.4 9.4 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.8-2.4 4.6-4.6 4.9.4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10.2 10.2 0 0 0 12 1.8z" />
            break;

        default:
            <circle cx="12" cy="12" r="9" />
            break;
    }
</svg>

@code {
    /// <summary>Which icon to draw.</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;
}
